# The RLS Watch Supabase project itself (not a monitored client project).
WATCH_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
WATCH_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WATCH_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Telegram bot used to send alerts. Create one with @BotFather, then set each
# agency's chat id from the web app's Settings page.
TELEGRAM_BOT_TOKEN=

# Public URL the dashboard is served at (used in alert links).
WEB_URL=https://watch.example.com

# How often the worker sweeps all enabled projects, in minutes.
CHECK_INTERVAL_MINUTES=1440

# Read by web/ at build time (Vite). Same project as WATCH_SUPABASE_URL, anon key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
